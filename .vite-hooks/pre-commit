# - Runs pnpm test
#
# The shell function in ~/.shell-functions/codiff.zsh is now the source of truth
# for running codiff during development, so no global linking is needed.

set -eu

cd "$(git rev-parse --show-toplevel)"

echo "→ vp staged (format • lint • typecheck)..."
vp staged "$@"

echo "→ pnpm build..."
pnpm build

echo "→ pnpm test (full test suite — remove if it becomes too slow)..."
pnpm test
