# Personal development flags for codiff (copy to .env.local and edit)
#
# When set to 1, the pre-commit hook will automatically re-link the
# global `codiff` binary after every build.
#
# This is extremely convenient when you are iterating on the CLI itself:
#   git commit → fresh build + fresh global link → `codiff` everywhere is up to date.
#
# Leave it unset (or 0) if you prefer to run the link manually.
CODIFF_LINK_PRECOMMIT=1

# Optional: force the linker to use npm instead of pnpm (only if pnpm link -g
# keeps failing for you on this machine).
# CODIFF_LINK_TOOL=npm
